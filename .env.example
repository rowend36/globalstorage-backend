# Shared deployment values. Copy this file to .env.
MAIL_HOST=mail.globalstorage-prod.example.com
MAIL_DOMAIN=globalstorage-prod.example.com
PREVIEW_MAIL_DOMAIN=preview.example.com
MAIL_PROVIDER=smtp
# MAIL_ENABLED=false stops the deploy pipeline from starting the self-hosted
# mailserver (and its cert/account phases). set it false when using Resend.
MAIL_ENABLED=true
MAIL_FROM=noreply@globalstorage-prod.example.com
MAIL_FROM_NAME=Global Storage
ACME_EMAIL=admin@globalstorage-prod.example.com
# Resend provider: MAIL_PROVIDER=resend + RESEND_API_KEY=re_...
# RESEND_API_KEY=

# These values select providers; NODE_ENV is deliberately not used for provider selection.
DATABASE_DRIVER=sqlite
SQLITE_PATH=data/app.sqlite
CACHE_PROVIDER=memory
QUEUE_PROVIDER=memory
STORAGE_PROVIDER=filesystem
STORAGE_DIRECTORY=uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
S3_BUCKET=
S3_REGION=
FRONTEND_URL=http://localhost:3000
SMS_PROVIDER=console
MONITORING_PROVIDER=console
LOG_LEVEL=info
# When set, Info+ pino logs are piped to this file instead of the terminal;
# Warn/Error still reach stdout.
LOG_FILE=logs/combined.log
# Human-readable (colored) pino output on stdout. JSON is preserved for the
# log file and any remote sink.
LOG_PRETTY=false
# Loki (Grafana Cloud) streaming. Enabling LOKI_URL adds a pino-loki stream.
# LOKI_URL=https://logs-prod-<instance>.grafana.net/loki/api/v1/push
# LOKI_USERNAME=<instance-id>
# LOKI_PASSWORD=<grafana-cloud-access-token>
# LOKI_ORG_ID=<instance-id, when your tenant needs an explicit org header>
# LOKI_LABELS={"application":"globalstorage-backend"}
OTEL_ENABLED=false
OTEL_SERVICE_NAME=globalstorage-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example/v1/traces
JWT_SECRET=replace-with-a-long-random-secret
API_VERSION=1
SWAGGER_ENABLED=false
REFRESH_HASH_PEPPER=replace-with-a-separate-long-random-secret
REFRESH_IDLE_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=7776000
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_SECURE=true
PLATFORM_MFA_POLICY=any
FIELD_ENCRYPTION_KEY=
# Rotation format: v1:<base64-32-byte-key>,v2:<base64-32-byte-key>
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_CURRENT_VERSION=
OIDC_ISSUER_URL=https://idp.example.gov
OIDC_CLIENT_ID=globalstorage-api
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://api.example.gov/v1/auth/oidc/callback
# PostgreSQL option: DATABASE_DRIVER=postgresql, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
# Redis option: CACHE_PROVIDER=redis / QUEUE_PROVIDER=redis, REDIS_URL
# Jobs option: QUEUE_REDIS_URL (or REDIS_URL) enables the BullMQ worker;
# without it, jobs run in-process (dev-only). QUEUE_WORKER_CONCURRENCY=5
# Superuser wildcard claim ('*') is only honored on platform claims, never in production.
ALLOW_SUPERUSER_CLAIM=false
# Production providers: STORAGE_PROVIDER=s3; MAIL_PROVIDER=resend
