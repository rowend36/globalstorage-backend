DB_NAME=globalstorage_preview
DB_USER=globalstorage_preview
DB_PASSWORD=replace-with-a-preview-password
PREVIEW_DEPENDENCIES_IMAGE=ghcr.io/owareoro/globalstorage-backend:preview-dependencies
JWT_SECRET=replace-with-a-preview-secret
REFRESH_HASH_PEPPER=replace-with-a-preview-pepper
SWAGGER_ENABLED=true
AUTH_COOKIE_SECURE=true
CACHE_PROVIDER=redis
QUEUE_PROVIDER=redis
STORAGE_PROVIDER=filesystem
STORAGE_DIRECTORY=/app/uploads
STORAGE_PUBLIC_URL=https://preview.example.com/uploads
MAIL_PROVIDER=smtp
SMTP_USER=preview-sender@preview.example.com
SMTP_PASSWORD=replace-with-preview-smtp-password
# Resend provider: MAIL_PROVIDER=resend + RESEND_API_KEY=re_...
# RESEND_API_KEY=
MAIL_FROM=noreply@preview.example.com
MAIL_FROM_NAME=Global Storage
PREVIEW_DOMAIN=preview.example.com
