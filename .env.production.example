DB_NAME=globalstorage_prod
DB_USER=globalstorage
DB_PASSWORD=replace-with-a-long-random-password
PRODUCTION_IMAGE=ghcr.io/owareoro/globalstorage-backend:production
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_HASH_PEPPER=replace-with-a-separate-long-random-secret
SWAGGER_ENABLED=false
AUTH_COOKIE_SECURE=true
CACHE_PROVIDER=redis
QUEUE_PROVIDER=redis
STORAGE_PROVIDER=filesystem
STORAGE_DIRECTORY=/app/uploads
STORAGE_PUBLIC_URL=https://globalstorage-prod.example.com/uploads
MAIL_PROVIDER=smtp
SMTP_USER=production-sender@globalstorage-prod.example.com
SMTP_PASSWORD=replace-with-production-smtp-password
MAIL_FROM=noreply@globalstorage-prod.example.com
MAIL_FROM_NAME=Global Storage
PRODUCTION_DOMAIN=globalstorage-prod.example.com
