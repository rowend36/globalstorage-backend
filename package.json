{
  "name": "globalstorage-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "command": "node --require @swc-node/register --require tsconfig-paths/register src/commands/main.ts",
    "command:prod": "node dist/commands/main.js",
    "migration:up:compiled": "node dist/database/migration-runner.js",
    "lint": "oxlint --fix src test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json",
    "migration:create": "mikro-orm migration:create",
    "migration:generate": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:create:pg": "cross-env DATABASE_DRIVER=postgresql mikro-orm migration:create",
    "migration:create:sqlite": "cross-env DATABASE_DRIVER=sqlite mikro-orm migration:create",
    "migration:create:pg:initial": "cross-env DATABASE_DRIVER=postgresql mikro-orm migration:create --initial",
    "migration:create:sqlite:initial": "cross-env DATABASE_DRIVER=sqlite mikro-orm migration:create --initial",
    "migration:up:pg": "cross-env DATABASE_DRIVER=postgresql mikro-orm migration:up",
    "migration:up:sqlite": "cross-env DATABASE_DRIVER=sqlite mikro-orm migration:up",
    "migration:down:pg": "cross-env DATABASE_DRIVER=postgresql mikro-orm migration:down",
    "migration:down:sqlite": "cross-env DATABASE_DRIVER=sqlite mikro-orm migration:down",
    "migration:fresh:pg": "cross-env DATABASE_DRIVER=postgresql mikro-orm migration:fresh",
    "migration:fresh:sqlite": "cross-env DATABASE_DRIVER=sqlite mikro-orm migration:fresh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/lib-storage": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/cli": "^7.1.13",
    "@mikro-orm/core": "^7.1.13",
    "@mikro-orm/migrations": "^7.1.13",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.13",
    "@mikro-orm/sqlite": "^7.1.13",
    "@nestjs-redis/client": "^1.4.0",
    "@nestjs-redis/throttler-storage": "^1.4.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@sentry/nestjs": "^10.71.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.2.2",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nest-commander": "^3.20.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.7",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.24.0",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.0.0",
    "oxlint": "^1.80.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true,
              "decoratorsMetadata": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(openid-client|@mikro-orm|kysely|@scure|@otplib|@noble)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
